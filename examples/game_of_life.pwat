      br 0
    end
  )

  ;; print_cell: arg 0 = value
  (func (args 1) (locals 0) (results 0)
    local.get 0
    i32.eqz
    if
      i32.const 0
      i32.const 1
      call print
    else
      i32.const 2
      i32.const 1
      call print
    end
  )
)
