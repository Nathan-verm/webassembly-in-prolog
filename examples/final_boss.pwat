(module
	(start 0)

	(data 0 "Final Boss Demo")
	(data 20 "Type a number between 0 and 100: ")
	(data 60 "equal")
	(data 70 "not equal")
	(data 90 "counter value: ")
	(data 110 "Wat is 5 + 5?")

	;; main
	(func (args 0) (locals 0) (results 0)
		i32.const 0
		i32.const 15
		call println

		;; arithmetic demo
		call 1
		drop

		;; comparison + bitwise demo
		call 2
		drop

		;; locals + block/loop/br/br_if demo
		i32.const 90
		i32.const 15
		call print
		call 3
		call print_int

		;; read_int + rand_int + if/else + print/println demo
		call 4
		drop

		;; if without else + unreachable (user can trigger trap) + return demo
		call 5
		call print_int
	)

	;; arithmetic: add/sub/mul/div_s
	(func (args 0) (locals 0) (results 1)
		i32.const 7
		i32.const 5
		i32.add

		i32.const 3
		i32.sub

		i32.const 2
		i32.mul

		i32.const 3
		i32.div_s
	)

	;; comparisons: lt/le/gt/ge/eq/ne/eqz + bitwise and/or/xor
	(func (args 0) (locals 0) (results 1)
		i32.const 4
		i32.const 6
		i32.lt_s
		drop

		i32.const 6
		i32.const 6
		i32.le_s
		drop

		i32.const 8
		i32.const 3
		i32.gt_s
		drop

		i32.const 8
		i32.const 8
		i32.ge_s
		drop

		i32.const 9
		i32.const 9
		i32.eq
		drop

		i32.const 9
		i32.const 10
		i32.ne
		drop

		i32.const 6
		i32.const 3
		i32.and
		drop

		i32.const 6
		i32.const 3
		i32.or
		drop

		i32.const 6
		i32.const 3
		i32.xor
		drop

		i32.const 0
		i32.eqz
	)

	;; locals + loop + br_if + block + br + local.tee + nop
	(func (args 0) (locals 2) (results 1)
		nop

		i32.const 0
		local.set 0

		i32.const 3
		local.set 1

		block
			loop
				local.get 0
				i32.const 1
				i32.add
				local.tee 0
				drop

				local.get 0
				local.get 1
				i32.lt_s
				br_if 0
			end

			br 0

			i32.const 999
			local.set 0
		end

		local.get 0
	)

	;; print/read/rand/if-else demo
	(func (args 0) (locals 2) (results 1)
		i32.const 20
		i32.const 33
		call print

		i32.const 0
		i32.const 100
		call read_int
		local.set 0

		i32.const 0
		i32.const 100
		call rand_int
		local.set 1

		local.get 0
		local.get 1
		i32.eq
		if
			i32.const 60
			i32.const 5
			call println
		else
			i32.const 70
			i32.const 9
			call println
		end

		local.get 0
		local.get 1
		i32.eq
	)

	;; quiz: fout antwoord triggert unreachable
	(func (args 0) (locals 0) (results 1)
		i32.const 110
		i32.const 13
		call println

		i32.const 0
		i32.const 100
		call read_int

		i32.const 10
		i32.ne
		if
			unreachable
		end

		i32.const 20
		i32.const 4
		i32.div_s
		return
	)
)
